#!/usr/bin/env bash
# 원격이 없으면 이 훅이 유일한 기계 게이트다. --no-verify 는 금지한다.
#
# 검사 대상은 작업 트리가 아니라 인덱스(스테이징된 내용)다.
# 커밋에 들어가는 것은 인덱스인데 작업 트리를 검사하면, 나쁜 파일을 스테이징한 뒤 작업 트리에서만
# 고쳐도 통과한다. 실제로 재현된 구멍이다. 변경 파일을 명시해 부분 스테이징하는 이 방법에서는
# 인덱스와 작업 트리가 다른 것이 정상 상태이므로, 이 차이는 드문 예외가 아니라 상시 조건이다.
#
# 그래서 인덱스를 임시 디렉터리로 꺼내 그 위에서 verify.sh 를 돌린다.
# 스테이징되지 않은 생성물이 빌드에 필요하다면 그것은 커밋 스냅샷의 재현성 문제이고, 여기서 드러나는 것이 맞다.
#
# 범위는 --fast 다. 그 근거는 scripts/verify.sh 머리말에 있다.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git -C "$root" checkout-index --all --prefix="$tmp/"
# 빌드 캐시와 모듈 캐시는 공유한다. 인덱스 스냅샷을 검사하는 것이지 환경을 새로 만드는 것이 아니다.
cd "$tmp"
bash scripts/verify.sh --fast
